# LLM provider — one of: Groq, OpenAI, Claude, Gemini, Custom OpenAI Compatible Endpoint
DEFAULT_PROVIDER=Groq

# Provider credentials + models
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# Generation
TEMPERATURE=0.7
TOP_P=0.9
MAX_TOKENS=2048
STREAMING=true

# Embeddings (SentenceTransformers via HuggingFaceEmbeddings by default; use OpenAI for OpenAIEmbeddings)
EMBEDDING_PROVIDER=SentenceTransformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Retrieval / chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_RESULTS=5
MAX_HISTORY=6

# Optional LangGraph stages
ENABLE_QUERY_EXPANSION=false
ENABLE_RERANK=false

# Storage paths
CHROMA_PATH=data/chroma_db
SQLITE_PATH=data/rag.sqlite3
UPLOAD_DIR=uploads
CACHE_DIR=cache

# Logging
LOG_LEVEL=INFO
